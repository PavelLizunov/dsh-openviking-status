{
  "name": "@dipertq/dsh-openviking-status",
  "version": "0.1.7",
  "description": "Minimalist OpenViking status chip and popover for DeepSeek Harness composer",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipertq/dsh-openviking-status.git"
  },
  "homepage": "https://github.com/dipertq/dsh-openviking-status#readme",
  "bugs": {
    "url": "https://github.com/dipertq/dsh-openviking-status/issues"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.cts",
      "import": "./lib/client.js",
      "default": "./lib/client.cjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup",
    "pretest": "tsup",
    "dev": "tsup --watch",
    "test": "node --test tests/*.test.ts",
    "prepare": "tsup && (husky || true)",
    "prepack": "tsup",
    "preversion": "pnpm run build && pnpm test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "dsh-plugin",
    "openviking",
    "deepseek-harness",
    "status-bar",
    "memory"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
